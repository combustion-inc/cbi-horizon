<script src="https://cdn.jsdelivr.net/npm/@splidejs/splide@4.1.4/dist/js/splide.min.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@splidejs/splide@4.1.4/dist/css/splide.min.css">
{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  {%- comment -%} Horizon has no Dawn `.page-width`; constrain this section's wrapper like Dawn did so the carousel width is bounded. {%- endcomment -%}
  #shopify-section-{{ section.id }} .page-width-content {
    max-width: var(--page-width, 1200px);
    margin-inline: auto;
    padding-inline: 1.5rem;
  }
  {%- comment -%} Horizon's global img { width:100% } feeds Splide autowidth a full image width; scope slide images to their container. {%- endcomment -%}
  #shopify-section-{{ section.id }} .splide__slide__container { width: 100%; }
  #shopify-section-{{ section.id }} .splide__slide__container img {
    width: 100%;
    height: auto;
    display: block;
  }
{%- endstyle -%}

{% assign parameters = section.settings.parameters %}
{% assign slides = section.settings.slides %}
{% if parameters contains 'video' and slides contains 'vimeo' %}
	<script src="https://cdn.jsdelivr.net/npm/@splidejs/splide-extension-video@0.8.0/dist/js/splide-extension-video.min.js"></script>
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@splidejs/splide-extension-video@0.8.0/dist/css/splide-extension-video.min.css">
{% endif %}
{% if parameters contains 'autoScroll' %}
	<script src="https://cdn.jsdelivr.net/npm/@splidejs/splide-extension-auto-scroll@0.5.3/dist/js/splide-extension-auto-scroll.min.js"></script>
{% endif %}

{% assign title = section.settings.title | handleize %}
<script>
document.addEventListener('DOMContentLoaded', function() {
  var splide =  new Splide('#{{ title }}', {
    {{ parameters }}
    })
  {% if section.settings.splide_autoplay %}
	splide.on('autoplay:pause', function(pauseVideoWhenCarouselPause) {
		splide.Components.Video.pause();
		console.log("video is paused");
	});
	splide.on('autoplay:play', function(playVideoWhenCarouselPlay) {
		splide.Components.Video.play();
		console.log("video is playing");
	});
{% endif %}
    splide.mount( window.splide.Extensions );
   {%- comment -%} {% if section.settings.splide_autoplay %}
	var toggleButton = splide.root.querySelector( '#{{ title }} .toggle-button' );

	splide.on( 'autoplay:play', function () {
	  toggleButton.setAttribute( 'aria-label', 'Pause autoplay' );
	} );

	splide.on( 'autoplay:pause', function () {
	  toggleButton.setAttribute( 'aria-label', 'Start autoplay' );
	} );
	toggleButton.addEventListener( 'click', function () {
	  var Autoplay = splide.Components.Autoplay;

	  if ( Autoplay.isPaused() ) {
	    Autoplay.play();
	  } else {
	    Autoplay.pause();
	  }
	} );
{% endif %}
{%- endcomment -%}
});
</script>
<div class="color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
<div class="{% if section.settings.include_margins %}page-width-content{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
	{{ section.settings.liquid_before }}
		<div class="splide" id="{{ title }}">
		  <div class="splide__track">
		    <ul class="splide__list">
		    		{{ slides }}
		    </ul>
		    {% if section.settings.splide_autoplay %}
			<div class="autoplay-controls">
				<ul class="splide__pagination"></ul>
				<button class="splide__toggle" type="button">
				  <svg xmlns="http://www.w3.org/2000/svg" fill="none" class="splide__toggle__play" viewBox="0 0 10 14"><path fill="currentColor" fill-rule="evenodd" d="M1.482.815A1 1 0 0 0 0 1.69v10.517a1 1 0 0 0 1.525.851L10.54 7.5a1 1 0 0 0-.043-1.728z" clip-rule="evenodd"/></svg>
				  <svg xmlns="http://www.w3.org/2000/svg" fill="none" class="splide__toggle__pause" viewBox="0 0 8 12"><path fill="currentColor" d="M1.2.75c-.387 0-.7.235-.7.525v9.45c0 .29.313.525.7.525s.7-.235.7-.525v-9.45c0-.29-.313-.525-.7-.525m5.6 0c-.387 0-.7.235-.7.525v9.45c0 .29.313.525.7.525s.7-.235.7-.525v-9.45c0-.29-.313-.525-.7-.525"/></svg>

				</button>
			</div>
		    {% endif %}
		  </div>
		  {{ section.settings.liquid_after_inside }}
		</div>
  {%- for block in section.blocks -%}
    {%- case block.type -%}
    {%- when 'custom_liquid' -%}
                  {{ block.settings.custom_liquid }}
    {% endcase %}
  {%- endfor -%}
</div>
</div>

{% schema %}
{
  "name": "Splide",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "include_margins",
      "default": true,
      "label": "Page width"
    },
    {
    	"type": "text",
    	"id": "title",
    	"label": "Title",
    	"info": "This will be handelized to create the id for the splide carousel"
    },
    {
      "type": "checkbox",
      "id": "splide_autoplay",
      "default": true,
      "label": "Autoplay",
      "info": "Using autoplay will add a play/pause control, which is required for accessibility. Make sure to include the right parameters for autoplay."
    },
    {
    	"type": "liquid",
    	"id": "parameters",
    	"label": "Parameters",
    	"info": "Settings for this splide carousel. E.g., perPage etc"
    },
    {
    	"type": "liquid",
    	"id": "slides",
    	"label": "Splide slides",
    	"info": "Put your <li> items code here. Use class splide__slide on the <li> and include an <img> in each <li>. Use additional <div class='splide__slide__container'> to put video in a container"
    },
    {
    	"type": "liquid",
    	"id": "liquid_before",
    	"label": "Liquid before",
    	"info": "Stuff that goes above the slides (outside of splide element)"
    },
        {
    	"type": "liquid",
    	"id": "liquid_after_inside",
    	"label": "Liquid after inside",
    	"info": "Stuff that goes after the slides (inside of splide element)"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "custom_liquid",
      "name": "Custom Liquid",
      "settings": [
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "Custom Liquid",
          "info": "This block will go after the slides"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Splide"
    }
  ]
}
{% endschema %}
