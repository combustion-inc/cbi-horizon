    "intro_hello": {
      "type": "section",
      "blocks": {
        "custom_liquid_tdnYGR": {
          "type": "custom-liquid",
          "name": "t:names.custom_liquid",
          "settings": {
            "custom_liquid": "{%- style -%}\n@media screen and (min-width: 990px) {\n   #shopify-section-{{ section.id }} {\n        background: url({{ images[\"pan-240.png\"] |image_url }}) right top / auto 90% no-repeat, url({{ images[\"knife-240.png\"] |image_url }}) left bottom / auto 90% no-repeat rgb(255, 207, 76);\n    }\n}\n\n\n{%- endstyle -%}"
          },
          "blocks": {}
        },
        "text_6yeBhg": {
          "type": "text",
          "name": "t:names.heading",
          "settings": {
            "text": "<h2>Hello. We're Combustion Inc.</h2><p>We build nice things that make cooking more enjoyable.</p><p>You don't need much to prepare a great meal. A sharp knife, a few good pans, and a modest assortment of other tools are enough. You should definitely have a good thermometer.&nbsp;</p><p>We made ours wireless and stuffed it with 8 temperature sensors. It works with our big and bold Kitchen Display and our iOS and Android apps. They’re all extremely easy to use.</p><p>Oh, and did we mention that our thermometer can <em>predict the future?</em> Let us explain…</p>",
            "width": "100%",
            "max_width": "none",
            "alignment": "left",
            "type_preset": "rte",
            "font": "var(--font-body--family)",
            "font_size": "1rem",
            "line_height": "normal",
            "letter_spacing": "normal",
            "case": "none",
