          ]
        },
        "faq_sources": {
          "type": "text",
          "settings": {
            "text": "<p><a href=\"https://www.ajihealthandnutrition.com/product/activa-rm/\">More about Activa RM from Ajinomoto</a>. Activa is a trademark of Ajinomoto.</p>",
            "width": "100%",
            "max_width": "none",
            "alignment": "left",
            "type_preset": "rte"
          },
          "blocks": {}
        }
      },
