                  "block_order": [
                    "faq_1_a"
                  ]
                },
                "faq_2": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Where does the probe go in a tenderloin?",
                    "open_by_default": false,
                    "icon": "none",
                    "width": 20
                  },
                  "blocks": {
                    "faq_2_a": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Into the thickest part of the roast, pushed in past the minimum insertion line. The sensors inside find the coldest spot for you, so you don't have to hit the exact center.</p>",
                        "width": "100%",
                        "max_width": "none",
                        "alignment": "left",
                        "type_preset": "rte",
                        "font": "var(--font-body--family)",
