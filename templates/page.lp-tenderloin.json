                        "background": false,
                        "background_color": "#00000026",
                        "corner_radius": 0,
                        "padding-block-start": 0,
                        "padding-block-end": 0,
                        "padding-inline-start": 0,
                        "padding-inline-end": 0
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "faq_3_a"
                  ]
                },
                "faq_4": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Do I need my phone?",
                    "open_by_default": false,
                    "icon": "none",
                    "width": 20
                  },
                  "blocks": {
                    "faq_4_a": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Not necessarily. The probe works with the free Combustion app on iOS, Android, macOS and watchOS, or you can read the countdown off the WiFi Display and leave the phone alone.</p>",
                        "width": "100%",
                        "max_width": "none",
