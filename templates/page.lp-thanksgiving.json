                          "type": "text",
                          "settings": {
                            "text": "<h3>Thawed, faster</h3>",
                            "width": "100%",
                            "max_width": "normal",
                            "alignment": "left",
                            "type_preset": "h4",
                            "font": "var(--font-body--family)",
                            "font_size": "1rem",
                            "line_height": "normal",
                            "letter_spacing": "normal",
                            "case": "none",
                            "wrap": "pretty",
                            "text_color": "{{ settings.color_palette.color7 }}",
