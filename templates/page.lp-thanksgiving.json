                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {}
            },
            "why_4_p": {
              "type": "text",
              "settings": {
                "text": "<p>White and dark meat are at their best at different temperatures. When the breast is juicy and ready to serve, the legs and thighs are still tough. Separate them and return the dark meat to the oven until it reaches at least 170°F, about 15 to 20 minutes, while you carve the rest.</p>",
                "width": "100%",
                "max_width": "none",
                "alignment": "left",
                "type_preset": "rte",
                "font": "var(--font-body--family)",
                "font_size": "1rem",
