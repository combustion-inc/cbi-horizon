                            "background_color": "#00000026",
                            "corner_radius": 0,
                            "padding-block-start": 0,
                            "padding-block-end": 0,
                            "padding-inline-start": 0,
                            "padding-inline-end": 0
                          },
                          "blocks": {}
                        },
                        "method_3_a": {
                          "type": "text",
                          "settings": {
                            "text": "<p><strong>Serves</strong> 8 to 12<br><strong>Prep</strong> 24 hours to 3 days<br><strong>Cook</strong> about 30% faster than low and slow</p><p>For owners of the Combustion Predictive Thermometer. This version works by watching the surface temperature, which only the thermometer can show you.</p><ol><li><strong>Dry brine and truss</strong> the turkey as in the low-and-slow version.</li><li><strong>Start with a hotter oven,</strong> around 300°F (150°C). Insert the Combustion Predictive Thermometer into the thickest part of the breast and put the turkey in.</li><li><strong>Watch the surface temperature.</strong> When the surface of the turkey comes up to within 10°F of your target core temperature, drop the oven to 200°F.</li><li><strong>Keep stepping down.</strong> Continue to drop the oven temperature, to as low as it can go, while the bird finishes cooking. The goal is to keep the surface temperature at around the target temperature throughout the cook.</li><li><strong>Rest, crisp the skin, and divide and conquer</strong> as in the low-and-slow version.</li></ol>",
                            "width": "100%",
                            "max_width": "none",
                            "alignment": "left",
                            "type_preset": "rte",
