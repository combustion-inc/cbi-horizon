                "faq_6": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "How hot can it get?",
                    "open_by_default": false,
                    "icon": "none",
                    "width": 20
                  },
                  "blocks": {
                    "faq_6_a": {
                      "type": "text",
                      "settings": {
                        "text": "<p>The handle end can take a 900°F (482°C) peak. For long cooks, keep it under 750°F (399°C). The tip inside your food is rated to 220°F (105°C), which is why it has to stay inside the food.</p>",
                        "width": "100%",
