/* Scandia Web Regular */
		@font-face {
				font-family: "ScandiaWeb";
				src: url("{{ 'ScandiaWebRegular.eot' | file_url }}");
				src: url("{{ 'ScandiaWebRegular.eot?#iefix' | file_url }}") format("embedded-opentype"),
						 url("{{ 'ScandiaWebRegular.woff2' | file_url }}") format("woff2"), 
						 url("{{ 'ScandiaWebRegular.woff' | file_url }}") format("woff");
				font-weight: 400;
				font-style: normal;
				font-display: swap;
		}
		/* Scandia Web Regular Italic */
		@font-face {
				font-family: "ScandiaWeb";
