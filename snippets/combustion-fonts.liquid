						 url("{{ 'ScandiaWebRegularItalic.woff2' | file_url }}") format("woff2"), 
						 url("{{ 'ScandiaWebRegularItalic.woff' | file_url }}") format("woff");
				font-weight: 400;
				font-style: italic;
				font-display: swap;
		}
		
